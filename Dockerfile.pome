# syntax=docker/dockerfile:1
# POME decision app (Streamlit). Build: docker compose -f compose.pome.yaml up --build
# Replays recorded results in runs/records; needs no API keys and no .env.

FROM python:3.11-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --frozen --no-dev

FROM python:3.11-slim AS runtime
LABEL org.opencontainers.image.source="https://github.com/bleng0/Chatbot-Recommendations"
RUN groupadd --system --gid 1001 app && useradd --system --uid 1001 --gid 1001 --create-home app
WORKDIR /app
COPY --link --from=build /opt/venv /opt/venv
COPY --link --chown=1001:1001 pome ./pome
COPY --link --chown=1001:1001 runs/records ./runs/records
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
USER app
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"]
CMD ["python", "-m", "streamlit", "run", "pome/app/home.py", \
     "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
